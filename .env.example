DATABASE_URL=postgres://user:password@localhost:5432/satamoni
JWT_SECRET=change-this-to-a-long-random-string
PORT=4000

# لتشغيل npm run seed:admin (أول حساب أدمن في النظام)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@satamoni.com
ADMIN_PASSWORD=change-this-password

# المرحلة 8.43: أتمتة واتساب - راجع docs/WHATSAPP-AUTOMATION.md لطريقة الحصول على كل قيمة تحت دي
# وربط الرقم فعليًا. النظام بيشتغل عادي من غيرها تمامًا (whatsapp_bot_enabled معطّل افتراضيًا في
# pos_settings، وأي إرسال هيرجع "not_configured" بهدوء من غير أي تأثير على باقي النظام)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# رقم واتساب داخلي (بصيغة دولية زي 201234567890) يوصله إشعار فوري لكل أوردر/شكوى جديدة - اختياري
WHATSAPP_STAFF_NOTIFY_NUMBER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# المرحلة 8.46: توسيع نفس البوت لفيسبوك ماسنجر وإنستجرام - نفس تطبيق ميتا (WHATSAPP_APP_SECRET/
# WHATSAPP_VERIFY_TOKEN فوق بيتستخدموا لكل القنوات، مفيش متغيرات منفصلة ليهم). اختياري تمامًا - من
# غيره واتساب لوحده بيفضل شغال عادي
FACEBOOK_PAGE_ACCESS_TOKEN=

# تكامل Talabat Partner API - راجع docs/TALABAT-INTEGRATION.md. القيم دي server-side فقط
# (ممنوع تتحط في أي frontend/sessionStorage). النظام بيشتغل عادي من غيرها - services/talabat/
# talabat-client.js بيرفض NOT_IMPLEMENTED بهدوء لحد ما المواصفة الحقيقية والـcredentials تتوفر
TALABAT_CLIENT_ID=
TALABAT_CLIENT_SECRET=
TALABAT_API_BASE_URL=
TALABAT_TOKEN_URL=
TALABAT_WEBHOOK_SECRET=
# اسم الـheader اللي فيه توقيع HMAC - افتراضي x-talabat-signature لحد ما نتأكد من الاسم الحقيقي
TALABAT_WEBHOOK_SIGNATURE_HEADER=x-talabat-signature
TALABAT_ENVIRONMENT=sandbox
