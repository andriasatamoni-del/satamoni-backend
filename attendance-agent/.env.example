# انسخ الملف ده لـ .env جنبه واملأ القيم الحقيقية بتاعتك قبل ما تشغّل الـAgent
API_BASE_URL=https://your-satamoni-backend.example.com
AGENT_EMAIL=attendanceagent@yourbranch.local
AGENT_PASSWORD=change-me

# اختياري - لو AGENT_EMAIL حساب "مدير فرع" (branch_manager) الفرع بيتحدد أوتوماتيك من الحساب نفسه، مش
# محتاج تحدده هنا خالص. حدده بس لو الحساب "أدمن" (مربوط بكل الفروع، مفيش فرع واحد يتحدد منه أوتوماتيك)
# BRANCH_ID=1

# عنوان IP بتاع جهاز البصمة ZK على شبكة الفرع (زي 192.168.1.201) والبورت (البروتوكول القياسي 4370)
ZK_DEVICE_IP=192.168.1.201
ZK_DEVICE_PORT=4370

# كل قد إيه (بالثانية) الـAgent يتصل بالجهاز ويسحب البصمات الجديدة - جهاز البصمة نفسه مش بيبعت push خالص،
# فده أقرب حاجة لـ"لحظي" ممكنة (5 دقايق افتراضيًا معقولة - مش محتاجين كل ثانية)
POLL_INTERVAL_SECONDS=300

# كل مرة بيسحب بصمات آخر كام يوم من الجهاز (مش من أول الشهر) - يوم أو اتنين كفاية لأن التاريخ زمن نازل بيتكتب
# فوق (upsert) من غير أي مشكلة، ده بس تحسين أداء (مايجيبش كل تاريخ الجهاز كل مرة)
LOOKBACK_DAYS=2
